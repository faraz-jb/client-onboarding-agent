# Dependencies
node_modules/

# Build outputs
.next/
out/
dist/
build/

# Environment & secrets — NEVER commit real keys
.env
.env.local
.env.*.local
.env.production
!.env.example
!.env.production.example

# Local data / databases — never committed.
# data/* ignores real client data (SQLite DBs, the Chroma vector store), but
# data/knowledge/ is re-included: those markdown docs are the committed RAG
# source corpus, not client data.
data/*
!data/knowledge/
data/knowledge_db/
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Promptfoo eval state — repo-local run history/cache written by
# `npm run rag`. Regenerated on every run; never committed.
.promptfoo/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
