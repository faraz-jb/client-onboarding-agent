# Gemini API key — real key sirf .env mein (local, gitignored), kabhi commit nahi.
# Setup: cp .env.example .env → apna key fill karo.
GEMINI_API_KEY=

# Model placement (hackathon requirement — never hardcode model ids in code):
# - Brain: main agent reasoning, proposal drafting, multi-step workflow decisions.
# - Fast: small sub-agents — lead classification, form/info extraction.
# NOTE: real model ids verified against the API (gemini-3.5-pro / gemini-3-flash
# do NOT exist). Brain pro model (gemini-3.1-pro-preview) is quota-gated on a
# free key — if you hit 429, set GEMINI_BRAIN_MODEL=gemini-3.6-flash locally.
GEMINI_BRAIN_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.5-flash

# Optional: override the SQLite file path used by both the Python agent
# (agent/memory.py) and the Next.js dashboard (lib/db.ts). Defaults to
# data/onboarding.db relative to the project root when unset.
DB_PATH=

# Admin auth (Phase 4) — dashboard + agent trigger are gated behind these.
# ADMIN_PASSWORD: plaintext admin password, read from env only. It is never
#   written to the database; the scrypt hash is derived on demand at login.
# ADMIN_PASSWORD_SALT: per-deployment scrypt salt (random, >=16 chars).
# SESSION_SECRET: HMAC-SHA256 key signing the session cookie (random, >=32
#   chars). Rotating it invalidates every issued session.
# All three must be set — with any missing, auth fails closed and every
# protected route denies access.
ADMIN_PASSWORD=
ADMIN_PASSWORD_SALT=
SESSION_SECRET=

# Telegram notify_client target (AI Invention Receptionist bot pattern).
# Token belongs to the bot; chat id is Faraz's own chat. Without both set,
# notify_client falls back to a console-log stub + audit row.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
