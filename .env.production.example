# Production environment for the Docker deploy.
# Copy to .env.production on the VPS and fill in real values:
#   cp .env.production.example .env.production
# .env.production is gitignored — never commit it.

# --- Gemini ---
# Real API key. Without it the agent falls back to its offline heuristic
# instead of calling Gemini.
GEMINI_API_KEY=

# Model placement. Brain handles proposal writing and multi-step reasoning;
# fast handles classification and extraction.
GEMINI_BRAIN_MODEL=gemini-3.1-pro-preview
GEMINI_FAST_MODEL=gemini-3.5-flash

# --- Admin auth (required) ---
# With any of these three missing, auth fails closed: every protected route
# denies and the dashboard is unreachable.
# Generate the salt and secret once with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_PASSWORD_SALT=
SESSION_SECRET=

# --- Database ---
# Do not change this path. The Next.js side reads DB_PATH, while
# agent/memory.py derives its own path from the agent package location
# (/app/agent/../data/onboarding.db). Both land on /app/data/onboarding.db,
# which docker-compose bind-mounts to ./data. Pointing DB_PATH anywhere else
# splits the two runtimes across two different database files.
DB_PATH=/app/data/onboarding.db

# --- Telegram notifications (optional) ---
# Without both values, notify_client logs to the console and still writes its
# audit row instead of sending a message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
